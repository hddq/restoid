    <string name="repo_warning_metadata_restore_failed">Repositori berhasil ditambahkan, tetapi pemulihan metadatanya (jadwal, info cadangan terperinci) gagal. Ini biasanya berarti snapshot metadata hilang atau repositori terkunci. Untuk mencoba lagi, buka Pengaturan → Repositori, ketuk menu repo, dan pilih “Pulihkan metadata”.</string>
    <!-- Tasks & Maintenance Guide -->
    <string name="cd_help">Bantuan</string>
    <string name="tasks_guide_title">Panduan Tugas &amp; Pemeliharaan</string>
    <string name="tasks_guide_subtitle">Pelajari fungsi setiap tugas pencadangan dan pemeliharaan serta cara kerjanya bersama-sama.</string>
    <string name="tasks_guide_unlock_title">Buka kunci repositori</string>
    <string name="tasks_guide_unlock_desc">Menghapus kunci kedaluwarsa yang tertinggal saat pencadangan atau tugas sebelumnya terganggu secara tidak terduga (mis. aplikasi ditutup, perangkat dimulai ulang, atau koneksi terputus). Ini memungkinkan tugas berikutnya berjalan dengan aman.</string>
    <string name="tasks_guide_forget_title">Lupakan snapshot</string>
    <string name="tasks_guide_forget_desc">Menerapkan kebijakan retensi Anda (mis. menyimpan N snapshot harian, mingguan, atau bulanan terakhir) dan menghapus catatan snapshot lama dari riwayat repositori. Catatan: Ini hanya menghapus referensi snapshot; belum menghapus potongan data mentah.</string>
    <string name="tasks_guide_prune_title">Pangkas repositori</string>
    <string name="tasks_guide_prune_desc">Memindai repositori untuk mencari potongan data yang tidak lagi direferensikan oleh snapshot yang tersisa, menghapusnya secara permanen, dan mempaketkan ulang untuk benar-benar mengosongkan ruang disk. Pemangkasan membutuhkan banyak sumber daya dan paling baik dijalankan secara berkala (mis. mingguan atau bulanan).</string>
    <string name="tasks_guide_check_title">Periksa integritas</string>
    <string name="tasks_guide_check_desc">Memeriksa struktur dan indeks repositori. Secara default, konten file yang disimpan tidak dibaca. Aktifkan Baca semua data di pengaturan Periksa Integritas untuk memverifikasi paket data juga.</string>
    <string name="tasks_guide_forget_vs_prune_title">Lupakan vs. Pangkas: Apa perbedaannya?</string>
    <string name="tasks_guide_forget_vs_prune_desc">Bayangkan Lupakan sebagai menghapus kartu katalog dari indeks perpustakaan, dan Pangkas sebagai benar-benar menyingkirkan buku yang tidak diperlukan dari gedung. Anda menjalankan Lupakan terlebih dahulu untuk memilih apa yang akan dihapus, lalu Pangkas sesudahnya untuk benar-benar mengosongkan ruang penyimpanan.</string>
    <string name="tasks_guide_apps_title">Aplikasi</string>
    <string name="tasks_guide_apps_desc">Mencadangkan aplikasi yang terinstal, termasuk APK, data aplikasi, data yang dilindungi perangkat, dan data penyimpanan eksternal.</string>
    <string name="tasks_guide_files_title">File &amp; Folder</string>
    <string name="tasks_guide_files_desc">Mencadangkan file dan direktori kustom yang dipilih dari penyimpanan perangkat.</string>
    <string name="tasks_guide_docs_button">Dokumentasi Resmi Restic</string>
