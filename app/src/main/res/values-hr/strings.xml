    <string name="repo_warning_metadata_restore_failed_title">Neuspjelo vraćanje metapodataka</string>
    <string name="repo_warning_metadata_restore_failed">Repozitorij je uspješno dodan, ali vraćanje njegovih metapodataka (rasporedi, detaljne informacije o sigurnosnim kopijama) nije uspjelo. To obično znači da nedostaje snimka metapodataka ili je repozitorij zaključan. Kako biste pokušali ponovo, otvorite Postavke → Repozitoriji, dodirnite izbornik repozitorija i odaberite „Vrati metapodatke“.</string>
    <!-- Tasks & Maintenance Guide -->
    <string name="cd_help">Pomoć</string>
    <string name="tasks_guide_title">Vodič za zadatke i održavanje</string>
    <string name="tasks_guide_subtitle">Saznajte što pojedini zadatak sigurnosne kopije i održavanja radi i kako međusobno surađuju.</string>
    <string name="tasks_guide_unlock_title">Otključaj spremište</string>
    <string name="tasks_guide_unlock_desc">Uklanja zaostala zaključavanja preostala nakon neočekivanog prekida prethodne sigurnosne kopije ili zadatka (npr. zatvorena aplikacija, ponovno pokrenut uređaj ili prekinuta veza). To omogućuje siguran nastavak budućih zadataka.</string>
    <string name="tasks_guide_forget_title">Zaboravi snimke</string>
    <string name="tasks_guide_forget_desc">Primjenjuje vašu politiku zadržavanja (npr. zadrži posljednjih N dnevnih, tjednih ili mjesečnih snimaka) i uklanja stare zapise snimaka iz povijesti spremišta. Napomena: Ovo samo uklanja referencu na snimke; još uvijek ne briše sirove dijelove podataka.</string>
    <string name="tasks_guide_prune_title">Očisti spremište</string>
    <string name="tasks_guide_prune_desc">Skenira spremište u potrazi za dijelovima podataka na koje više ne upućuje nijedna preostala snimka, trajno ih briše i prepakira pakete kako bi se stvarno oslobodio prostor na disku. Čišćenje zahtijeva mnogo resursa i najbolje ga je pokretati periodično (npr. tjedno ili mjesečno).</string>
    <string name="tasks_guide_check_title">Provjeri integritet</string>
    <string name="tasks_guide_check_desc">Provjerava strukturu spremišta i indekse. Prema zadanim postavkama sadržaj pohranjenih datoteka se ne čita. Omogućite opciju Čitaj sve podatke u postavkama provjere integriteta kako biste provjerili i podatkovne pakete.</string>
    <string name="tasks_guide_forget_vs_prune_title">Zaboravi vs. Očisti: U čemu je razlika?</string>
    <string name="tasks_guide_forget_vs_prune_desc">Zamislite \"Zaboravi\" kao uklanjanje kataložnih kartica iz knjižničnog indeksa, a \"Očisti\" kao stvarno uklanjanje nepotrebnih knjiga iz zgrade. Prvo pokrećete \"Zaboravi\" kako biste odabrali što ćete izbrisati, a zatim \"Očisti\" kako biste stvarno oslobodili prostor za pohranu.</string>
    <string name="tasks_guide_apps_title">Aplikacije</string>
    <string name="tasks_guide_apps_desc">Stvara sigurnosnu kopiju instaliranih aplikacija, uključujući APK-ove, podatke aplikacija, podatke zaštićene uređajem i podatke s vanjske pohrane.</string>
    <string name="tasks_guide_files_title">Datoteke i mape</string>
